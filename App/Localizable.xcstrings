        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 App 是刚装好或刚更新的，退出再重新打开一次，系统就会登记它。之后再去「系统设置 → 通用 → 登录项与扩展 → 文件系统扩展」里打开 GocryptKit。"
          }
        }
      }
